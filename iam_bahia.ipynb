# %% [markdown]
# ## Processamento e análise dos dados
# 
# ### Indicadores de estrutura

# %%
# Processamento dos dados de estabelecimentos de saúde
def processar_indicadores_estrutura():
    print("Processando indicadores de estrutura...")
    
    # Verifica se os dataframes estão disponíveis
    if df_estabelecimentos.empty or df_leitos.empty:
        print("Dados insuficientes para processar indicadores de estrutura")
        return pd.DataFrame()
    
    # Filtra estabelecimentos de urgência e emergência
    # Nota: Esta é uma implementação simulada, os filtros reais dependeriam da estrutura dos dados
    try:
        df_urgencia = df_estabelecimentos[
            df_estabelecimentos['tipo_unidade'].str.contains('URGENCIA|EMERGENCIA|PRONTO|SOCORRO', 
                                                            case=False, na=False)
        ].copy()
        
        # Filtra leitos de UTI
        df_uti = df_leitos[
            df_leitos['tipo_leito'].str.contains('UTI|INTENSIV', case=False, na=False)
        ].copy()
        
        # Agrega dados por região de saúde e ano
        indicadores_estrutura = []
        
        for codigo, nome in REGIOES_SAUDE.items():
            for ano in range(PERIODO_INICIO, PERIODO_FIM + 1):
                # Filtra por região e ano
                estab_regiao_ano = df_urgencia[
                    (df_urgencia['regiao_saude'] == codigo) & 
                    (df_urgencia['ano'] == ano)
                ]
                
                leitos_regiao_ano = df_uti[
                    (df_uti['regiao_saude'] == codigo) & 
                    (df_uti['ano'] == ano)
                ]
                
                # Calcula indicadores
                n_estabelecimentos = len(estab_regiao_ano)
                n_leitos_uti = leitos_regiao_ano['quantidade'].sum() if 'quantidade' in leitos_regiao_ano.columns else 0
                
                # Simula dados para SAMU e UPA (em um cenário real, estes viriam de fontes específicas)
                cobertura_samu = np.random.uniform(0.5, 0.9)  # Simulação
                n_upas = max(0, int(np.random.normal(5, 2)))  # Simulação
                
                indicadores_estrutura.append({
                    'codigo_regiao': codigo,
                    'nome_regiao': nome,
                    'ano': ano,
                    'estabelecimentos_urgencia': n_estabelecimentos,
                    'leitos_uti': n_leitos_uti,
                    'cobertura_samu': cobertura_samu,
                    'n_upas': n_upas
                })
        
        return pd.DataFrame(indicadores_estrutura)
    
    except Exception as e:
        print(f"Erro ao processar indicadores de estrutura: {e}")
        return pd.DataFrame()

# Processa os indicadores de estrutura
df_indicadores_estrutura = processar_indicadores_estrutura()

# Exibe os indicadores de estrutura
if not df_indicadores_estrutura.empty:
    print(f"Indicadores de estrutura processados: {len(df_indicadores_estrutura)} registros")
    display(df_indicadores_estrutura.head())
else:
    print("Não foi possível processar os indicadores de estrutura")

# %% [markdown]
# ### Indicadores de processo

# %%
# Processamento dos indicadores de processo
def processar_indicadores_processo():
    print("Processando indicadores de processo...")
    
    # Verifica se os dataframes estão disponíveis
    if df_internacoes.empty:
        print("Dados insuficientes para processar indicadores de processo")
        return pd.DataFrame()
    
    # Implementação simulada para indicadores de processo
    # Em um cenário real, estes indicadores seriam calculados a partir dos dados disponíveis
    try:
        indicadores_processo = []
        
        for codigo, nome in REGIOES_SAUDE.items():
            for ano in range(PERIODO_INICIO, PERIODO_FIM + 1):
                # Simula dados para os indicadores de processo
                atendimentos = int(np.random.normal(10000, 3000))  # Simulação
                tempo_resposta = np.random.normal(30, 10)  # Simulação (minutos)
                taxa_regulacao = np.random.uniform(0.6, 0.9)  # Simulação
                
                indicadores_processo.append({
                    'codigo_regiao': codigo,
                    'nome_regiao': nome,
                    'ano': ano,
                    'atendimentos_urgencia': atendimentos,
                    'tempo_resposta': tempo_resposta,
                    'taxa_regulacao': taxa_regulacao
                })
        
        return pd.DataFrame(indicadores_processo)
    
    except Exception as e:
        print(f"Erro ao processar indicadores de processo: {e}")
        return pd.DataFrame()

# Processa os indicadores de processo
df_indicadores_processo = processar_indicadores_processo()

# Exibe os indicadores de processo
if not df_indicadores_processo.empty:
    print(f"Indicadores de processo processados: {len(df_indicadores_processo)} registros")
    display(df_indicadores_processo.head())
else:
    print("Não foi possível processar os indicadores de processo")

