# %% [markdown]
# ## Coleta de dados
# 
# ### Dados de estabelecimentos de saúde (CNES)

# %%
# Função para coletar dados de estabelecimentos de saúde
async def coletar_dados_estabelecimentos():
    print("Coletando dados de estabelecimentos de saúde...")
    
    # Parâmetros para a consulta
    query = {
        "dataset": "estabelecimentos",
        "filters": {"uf": ESTADO},
        "limit": 1000
    }
    
    # Coleta dados para cada ano do período
    dfs = []
    for ano in range(PERIODO_INICIO, PERIODO_FIM + 1):
        print(f"Processando ano {ano}...")
        query["year"] = ano
        
        try:
            dados = await demas_connector.fetch(query)
            df = await demas_connector.normalize(dados)
            
            if not df.empty:
                df['ano'] = ano
                dfs.append(df)
            else:
                print(f"Nenhum dado encontrado para {ano}")
        except Exception as e:
            print(f"Erro ao coletar dados para {ano}: {e}")
    
    # Combina todos os dataframes
    if dfs:
        return pd.concat(dfs, ignore_index=True)
    else:
        return pd.DataFrame()

# Executa a coleta de dados
df_estabelecimentos = run_sync(coletar_dados_estabelecimentos)

# Exibe informações sobre os dados coletados
if not df_estabelecimentos.empty:
    print(f"Dados coletados: {len(df_estabelecimentos)} registros")
    display(df_estabelecimentos.head())
else:
    print("Nenhum dado de estabelecimento coletado")

